{
  "name": "michielgerritsen/extract-address-parts",
  "description": "Get the (Dutch) street, house number, and extension from a concatenated string",
  "minimum-stability": "stable",
  "license": "WTFPL",
  "authors": [
    {
      "name": "michielgerritsen",
      "email": "michiel@controlaltdelete.nl"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "MichielGerritsen\\ExtractAddressParts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MichielGerritsen\\ExtractAddressParts\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62 || ^11.5.50 || ^12.5.8 || ^13.2.6",
    "phpstan/phpstan": "^2.2"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "analyse": "vendor/bin/phpstan analyse"
  }
}
